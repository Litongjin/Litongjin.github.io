    <title>每日基础技术总结 · 2026-08-19 · Java 面向对象与接口</title>
    <link href="https://litongjin.github.io/2026/08/19/foundation/2026-08-19-foundation-java/"/>
    <id>https://litongjin.github.io/2026/08/19/foundation/2026-08-19-foundation-java/</id>
    <published>2026-08-19T10:34:21.000Z</published>
